# Anthropic API key — sign up at https://console.anthropic.com
# Required for mnemonic prompt generation (Claude Sonnet 4.6)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Google Gemini API key — sign up at https://aistudio.google.com
# Required for image generation (Imagen 4)
GEMINI_API_KEY=your_gemini_key_here

# Anki profile name (optional — auto-detects the first profile if not set)
# Run `ls ~/Library/Application\ Support/Anki2/` to see your profiles
# ANKI_PROFILE=Abu

# Override Anki's bundled Python path (optional — default works on macOS)
# ANKI_PYTHON=/Library/Application\ Support/AnkiProgramFiles/.venv/bin/python3.13
